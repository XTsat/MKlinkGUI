<Page
  x:Class="MKlinkGUI.Views.Pages.HomePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:MKlinkGUI.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:properties="clr-namespace:MKlinkGUI.Resources.Localization"
  Title="HomePage"
  d:DataContext="{d:DesignInstance local:HomePage,
                                     IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
    <Page.Resources>
        <Style x:Key="OpenButtonTextStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="{x:Static properties:Lang.Home_Btn_OpenFile}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=FolderToggle}" Value="True">
                    <Setter Property="Text" Value="{x:Static properties:Lang.Home_Btn_OpenFolder}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OpenButtonIconStyle" TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="Document24"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=FolderToggle}" Value="True">
                    <Setter Property="Symbol" Value="FolderOpen24"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    
    <Grid VerticalAlignment="Top" Cursor="">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MaxWidth="1000"/>
            <ColumnDefinition Width="Auto" MinWidth="126" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition/>
        </Grid.RowDefinitions>

        <ui:TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Right" Padding="0,0,10,0" 
                      Text="{x:Static properties:Lang.Home_Path_SourcePath}"/>

        <ui:TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Right" Padding="0,0,10,0"
                      Text="{x:Static properties:Lang.Home_Path_TargetPath}"/>

        <ui:TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Right" Padding="0,0,10,0"
                      Text="{x:Static properties:Lang.Home_Mode}"/>

        <ui:TextBox x:Name="SourceTextBox" PlaceholderText="{x:Static properties:Lang.Home_Path_SourcePath_Value}" Height="36" MinWidth="180"
                    VerticalContentAlignment="Center" Margin="10,0,10,0" Grid.Column="1" Grid.Row="0"
                    AllowDrop="True" Drop="TextBox_Drop" PreviewDragOver="TextBox_PreviewDragOver" KeyDown="TextBox_KeyDown"
                    ToolTip="{x:Static properties:Lang.Home_Path_SourcePath_Tip}"/>

        <ui:Button x:Name="SourceOpenButton" Click="SelectFile_Click" Height="36" Padding="12,0,12,0" Grid.Row="0" Grid.Column="2" HorizontalContentAlignment="Left" >
            <ui:Button.Content>
                <TextBlock Style="{StaticResource OpenButtonTextStyle}"/>
            </ui:Button.Content>
            <ui:Button.Icon>
                <ui:SymbolIcon Style="{StaticResource OpenButtonIconStyle}"/>
            </ui:Button.Icon>
        </ui:Button>

        <ui:TextBox x:Name="TargetTextBox" PlaceholderText="{x:Static properties:Lang.Home_Path_TargetPath_Value}" Height="36" MinWidth="180"
                    VerticalContentAlignment="Center" Margin="10,0,10,0" Grid.Column="1" Grid.Row="1" 
                    AllowDrop="True" Drop="TextBox_Drop" PreviewDragOver="TextBox_PreviewDragOver" Cursor="IBeam" KeyDown="TextBox_KeyDown"
                    ToolTip="{x:Static properties:Lang.Home_Path_TargetPath_Tip}"/>

        <ui:Button x:Name="TargetOpenButton" Click="SelectFile_Click" Height="36" Padding="12,0,12,0" Grid.Row="1" Grid.Column="2" HorizontalContentAlignment="Left" >
            <ui:Button.Content>
                <TextBlock Style="{StaticResource OpenButtonTextStyle}"/>
            </ui:Button.Content>
            <ui:Button.Icon>
                <ui:SymbolIcon Style="{StaticResource OpenButtonIconStyle}"/>
            </ui:Button.Icon>
        </ui:Button>

        <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" MinWidth="300">
            <RadioButton x:Name="SymbolicLinkRadio"
                    Content="{x:Static properties:Lang.Home_Mode_SymbolicLinkRadio}" Padding="10,0,20,0"
                    GroupName="radio_group_one" IsChecked="True"
                    ToolTip="{x:Static properties:Lang.Home_Mode_SymbolicLinkRadioTip}" Checked="LinkTypeChanged" />
            <RadioButton x:Name="FolderLinkRadio"
                    Content="{x:Static properties:Lang.Home_Mode_FolderLinkRadio}" Padding="20,0,20,0"
                    GroupName="radio_group_one" 
                    ToolTip="{x:Static properties:Lang.Home_Mode_FolderLinkRadioTip}" Checked="LinkTypeChanged" />
            <RadioButton x:Name="HardLinkRadio"
                    Content="{x:Static properties:Lang.Home_Mode_HardLinkRadio}" Padding="20,0,20,0"
                    GroupName="radio_group_one" 
                    ToolTip="{x:Static properties:Lang.Home_Mode_HardLinkRadioTip}" Checked="LinkTypeChanged"  />
        </StackPanel>

        <ui:ToggleSwitch x:Name="FolderToggle" Grid.Column="2" Grid.Row="2" OffContent="{x:Static properties:Lang.Home_Mode_File}" OnContent="{x:Static properties:Lang.Home_Mode_Folder}" IsChecked="True"/>

        <StackPanel Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center">

            <ui:Button x:Name="RunButton" Height="60" Click="RunButton_Click" Padding="10,0,10,0" Grid.Column="1" Margin="10,10,0,10" FontSize="20"
                   Grid.Row="3" MinWidth="300" Appearance="Primary">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="TriangleRight32" Margin="0,0,8,0"/>
                    <TextBlock Text="{x:Static properties:Lang.Home_Btn_Run}" FontSize="20" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:Button>

            <ui:Button x:Name="CopyCommandButton" Height="60" Click="CopyCommand_Click" Padding="10,0,10,0" Grid.Column="1" Margin="10,10,0,10" FontSize="20"
                   Grid.Row="3" MinWidth="60" Appearance="Secondary">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Copy24" Margin="0,0,8,0"/>
                    <TextBlock Text="{x:Static properties:Lang.Home_Btn_CopyCommand}" FontSize="20" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:Button>

            <ui:Button x:Name="RunAsAdminButton" Height="36" Click="RunAsAdminButton_Click" Padding="10,0,10,0" Grid.Column="1" Margin="10,10,0,10" FontSize="20"
                   Grid.Row="3" MinWidth="60" Appearance="Danger" Background="#fbfbfb">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Shield24" Margin="0,0,8,0" FontSize="14"/>
                    <TextBlock Text="{x:Static properties:Lang.Home_Btn_Admin}" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:Button>

        </StackPanel>

    </Grid>

</Page>
