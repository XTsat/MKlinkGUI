<Page
  x:Class="MKlinkGUI.Views.Pages.HomePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:MKlinkGUI.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="HomePage"
  d:DataContext="{d:DesignInstance local:HomePage,
                                     IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
    <Page.Resources>
        <Style x:Key="OpenButtonTextStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="打开文件"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=FolderToggle}" Value="True">
                    <Setter Property="Text" Value="打开文件夹"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OpenButtonIconStyle" TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="Document24"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=FolderToggle}" Value="True">
                    <Setter Property="Symbol" Value="FolderOpen24"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    
    <Grid VerticalAlignment="Top" Cursor="">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MaxWidth="1000"/>
            <ColumnDefinition Width="Auto" MinWidth="126" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition/>
        </Grid.RowDefinitions>

        <ui:TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Right" Padding="0,0,10,0">
            源位置:
        </ui:TextBlock>

        <ui:TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Right" Padding="0,0,10,0">
            目标位置:
        </ui:TextBlock>

        <ui:TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Right" Padding="0,0,10,0">
            模式:
        </ui:TextBlock>

        <ui:TextBox x:Name="SourceTextBox" PlaceholderText="选择源位置" Height="36" MinWidth="180"
                    VerticalContentAlignment="Center" Margin="10,0,10,0" Grid.Column="1" Grid.Row="0"
                    AllowDrop="True" Drop="TextBox_Drop" PreviewDragOver="TextBox_PreviewDragOver" KeyDown="TextBox_KeyDown"
                    ToolTip="管理员权限下拖放可能失效&#10;可以使用复制粘贴获取文件位置"/>

        <ui:Button x:Name="SourceOpenButton" Click="SelectFile_Click" Height="36" Padding="12,0,12,0" Grid.Row="0" Grid.Column="2" HorizontalContentAlignment="Left" >
            <ui:Button.Content>
                <TextBlock Style="{StaticResource OpenButtonTextStyle}"/>
            </ui:Button.Content>
            <ui:Button.Icon>
                <ui:SymbolIcon Style="{StaticResource OpenButtonIconStyle}"/>
            </ui:Button.Icon>
        </ui:Button>

        <ui:TextBox x:Name="TargetTextBox" PlaceholderText="选择目标位置" Height="36" MinWidth="180"
                    VerticalContentAlignment="Center" Margin="10,0,10,0" Grid.Column="1" Grid.Row="1" 
                    AllowDrop="True" Drop="TextBox_Drop" PreviewDragOver="TextBox_PreviewDragOver" Cursor="IBeam" KeyDown="TextBox_KeyDown"
                    ToolTip="管理员权限下拖放可能失效&#10;可以使用复制粘贴获取文件位置"/>

        <ui:Button x:Name="TargetOpenButton" Click="SelectFile_Click" Height="36" Padding="12,0,12,0" Grid.Row="1" Grid.Column="2" HorizontalContentAlignment="Left" >
            <ui:Button.Content>
                <TextBlock Style="{StaticResource OpenButtonTextStyle}"/>
            </ui:Button.Content>
            <ui:Button.Icon>
                <ui:SymbolIcon Style="{StaticResource OpenButtonIconStyle}"/>
            </ui:Button.Icon>
        </ui:Button>

        <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" MinWidth="300">
            <RadioButton x:Name="SymbolicLinkRadio"
                    Content="符号链接 /D" Padding="10,0,20,0"
                    GroupName="radio_group_one" IsChecked="True"
                    ToolTip="@todo" Checked="LinkTypeChanged" />
            <RadioButton x:Name="JunctionRadio"
                    Content="目录链接 /J" Padding="20,0,20,0"
                    GroupName="radio_group_one" 
                    ToolTip="@todo" Checked="LinkTypeChanged" />
            <RadioButton x:Name="HardLinkRadio"
                    Content="硬链接 /H" Padding="20,0,20,0"
                    GroupName="radio_group_one" 
                    ToolTip="@todo" Checked="LinkTypeChanged"  />
        </StackPanel>

        <ui:ToggleSwitch x:Name="FolderToggle" Grid.Column="2" Grid.Row="2" OffContent="文件" OnContent="文件夹" IsChecked="True"/>

        <ui:Button x:Name="RunButton" Height="60" Click="RunButton_Click" Padding="20,0,20,0" Grid.Column="1" Margin="20,20,0,10" FontSize="20"
                   Grid.Row="3" MinWidth="360" Appearance="Primary">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="TriangleRight32" Margin="0,0,8,0"/>
                <TextBlock Text="运行" FontSize="20" VerticalAlignment="Center"/>
            </StackPanel>
        </ui:Button>

        <StackPanel Grid.Row="3" Grid.Column="2" VerticalAlignment="Center">
            <ui:Button x:Name="RunAsAdminButton" 
                       Content="管理员权限" Height="36"
                       Icon="{ui:SymbolIcon Symbol=Shield24}"
                       Click="RunAsAdminButton_Click"
                       Appearance="Secondary" />
        </StackPanel>
        
    </Grid>

</Page>
